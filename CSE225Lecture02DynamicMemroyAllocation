#include <iostream>
#include <cstdio>

using namespace std;

void runPointerAndArrayDemo() {
    char str[5] = {'H', 'E', 'L', 'L', 'O'};
    char *ptr = &str[0];
    printf("ptr = %p\n", (void *)ptr);
    printf("str = %p\n", (void *)str);
}

void runSingleIntAllocationDemo() {
    int *ptr = new int;
    *ptr = 22;
    cout << "Single allocated int: " << *ptr << endl;
    delete ptr;
    ptr = nullptr;
}

void runGradesArrayDemo() {
    int *grades = nullptr;
    int numberOfGrades = 0;

    cout << "Enter the number of grades: ";
    cin >> numberOfGrades;

    if (numberOfGrades <= 0) {
        cout << "Invalid number of grades." << endl;
        return;
    }

    grades = new int[numberOfGrades];
    for (int i = 0; i < numberOfGrades; i++) {
        cin >> grades[i];
    }

    for (int j = 0; j < numberOfGrades; j++) {
        cout << grades[j] << " ";
    }
    cout << endl;

    delete[] grades;
    grades = nullptr;
}

void runMatrix2DDemo() {
    int rows = 0, columns = 0;
    cout << "Enter rows and columns for 2D matrix: ";
    cin >> rows >> columns;

    if (rows <= 0 || columns <= 0) {
        cout << "Invalid matrix dimensions." << endl;
        return;
    }

    int **matrix = new int*[rows];
    for (int i = 0; i < rows; i++) {
        matrix[i] = new int[columns];
    }

    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < columns; j++) {
            matrix[i][j] = (i + 1) * 10 + (j + 1);
            cout << matrix[i][j] << " ";
        }
        cout << endl;
    }

    for (int i = 0; i < rows; i++) {
        delete[] matrix[i];
    }
    delete[] matrix;
    matrix = nullptr;
}

void runMemorySafetyDemo() {
    // Safe pointer reassignment (avoiding memory leak)
    int *ptr1 = new int;
    int *ptr2 = new int;
    *ptr1 = 8;
    *ptr2 = 5;

    delete ptr2;      // Free memory pointed to by ptr2 before reassigning
    ptr2 = ptr1;      // Point both to the same heap integer
    cout << "Shared value after safe reassignment: " << *ptr2 << endl;

    delete ptr1;      // Free the single remaining allocation once
    ptr1 = nullptr;   // Prevent dangling pointer
    ptr2 = nullptr;   // Prevent second dangling pointer
}

int main() {
    runPointerAndArrayDemo();
    runSingleIntAllocationDemo();
    runMemorySafetyDemo();
    runGradesArrayDemo();
    runMatrix2DDemo();

    return 0;
}
